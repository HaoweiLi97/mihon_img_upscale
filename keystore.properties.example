# Copy to keystore.properties (ignored by Git) and restore the dedicated release credentials.
# Prefer forward slashes in Windows paths. Keep the actual configuration outside version control.
storeFile=C:/path/to/mihon-upscale-release-2026.p12
storePassword=REPLACE_WITH_SAVED_KEYSTORE_PASSWORD
keyAlias=mihon-upscale
keyPassword=REPLACE_WITH_SAVED_KEY_PASSWORD
